# Copy to .env and paste your licences. That's all tyk-otel needs.
# Versions are pinned in otel.env; secrets are generated by ./up.sh into .context/secrets.env.
DASHBOARD_LICENCE=<YOUR_DASHBOARD_LICENCE>
MDCB_LICENCE=<YOUR_MDCB_LICENCE>

# Optional: also forward all telemetry to Grafana Cloud
# (then uncomment otel/otel-collector/otelcol-config-extras.yml)
# GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
# GRAFANA_CLOUD_INSTANCE_ID=
# GRAFANA_CLOUD_API_KEY=
