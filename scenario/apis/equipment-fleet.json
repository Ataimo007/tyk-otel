{
  "api_definition": {
    "name": "Equipment & Fleet API",
    "slug": "demo-equipment-fleet",
    "api_id": "demo-equipment-fleet",
    "org_id": "1",
    "use_keyless": false,
    "auth": {
      "auth_header_name": "Authorization"
    },
    "enable_context_vars": true,
    "proxy": {
      "listen_path": "/fleet/",
      "target_url": "http://httpbin/anything/",
      "strip_listen_path": true
    },
    "active": true,
    "config_data": {
      "business_unit": "demo",
      "owner": "platform-team"
    },
    "version_data": {
      "not_versioned": true,
      "default_version": "Default",
      "versions": {
        "Default": {
          "name": "Default",
          "use_extended_paths": true,
          "extended_paths": {
            "track_endpoints": [
              {
                "path": "/equipment",
                "method": "GET",
                "disabled": false
              },
              {
                "path": "/equipment/{id}",
                "method": "GET",
                "disabled": false
              },
              {
                "path": "/equipment/{id}/telemetry",
                "method": "GET",
                "disabled": false
              },
              {
                "path": "/equipment/{id}/maintenance",
                "method": "POST",
                "disabled": false
              }
            ],
            "url_rewrites": [
              {
                "path": "/equipment/{id}/telemetry",
                "method": "GET",
                "match_pattern": ".*",
                "rewrite_to": "http://httpbin/delay/0.25",
                "triggers": []
              },
              {
                "path": "/equipment/{id}/maintenance",
                "method": "POST",
                "match_pattern": ".*",
                "rewrite_to": "http://httpbin/status/201,201,201,201,201,201,500,503",
                "triggers": []
              }
            ]
          }
        }
      }
    },
    "use_standard_auth": true,
    "base_identity_provided_by": "auth_token",
    "custom_middleware": {
      "driver": "goplugin",
      "pre": [],
      "post": [],
      "response": [],
      "auth_check": {
        "name": "",
        "path": ""
      },
      "post_key_auth": [
        {
          "name": "HashAPIKey",
          "path": "/opt/tyk-gateway/middleware/scenario/otel_custom_hash_metrics.so"
        }
      ]
    }
  }
}
